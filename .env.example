# Postgres connection string (Neon free tier works). Use a separate DB/branch for tests.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@host/dbname_test?sslmode=require
JWT_SECRET=change-me-at-least-32-chars-long-xxxxxxxx
PORT=4000
WEB_ORIGIN=http://localhost:5173
